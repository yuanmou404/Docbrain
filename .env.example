# DocBrain 配置（复制为 .env 后按需修改）
# 所有变量均可省略，省略时使用代码内默认值

# ── 模型 ─────────────────────────────────────────────
DOCBRAIN_LLM_MODEL=qwen2.5:7b
DOCBRAIN_EMBED_MODEL=bge-m3
DOCBRAIN_EMBED_DIM=1024
# 嵌入提供方式: ollama | local（local = 容器内 sentence-transformers 加载 BAAI/bge-m3）
DOCBRAIN_EMBED_PROVIDER=ollama

# cross-encoder 重排（bge-reranker-v2-m3，CPU 可用；追求速度可置 false）
DOCBRAIN_RERANKER_ENABLED=true
DOCBRAIN_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 权重下载源：国内网络或被代理证书拦截时改 https://hf-mirror.com（官方源为 https://huggingface.co）
DOCBRAIN_HF_ENDPOINT=https://hf-mirror.com

# ── 切分 ─────────────────────────────────────────────
DOCBRAIN_CHUNK_SIZE=512
DOCBRAIN_CHUNK_OVERLAP=64
DOCBRAIN_MIN_CHUNK_CHARS=50

# ── 检索 ─────────────────────────────────────────────
DOCBRAIN_TOP_K=8
DOCBRAIN_RRF_K=60
DOCBRAIN_RERANK_TOP_N=4
DOCBRAIN_CANDIDATE_MULTIPLIER=4

# 重排最高分低于该阈值 → 判定证据不足，直接拒答（不调用 LLM）
# 拒答阈值按 bge-reranker-v2-m3 实测校准（无关问题≤0.015 / 可答问题≥0.13）
DOCBRAIN_REFUSE_THRESHOLD=0.08

# ── OCR（扫描件分支）────────────────────────────────
DOCBRAIN_OCR_ENABLED=true
DOCBRAIN_OCR_MIN_TEXT_CHARS=24
DOCBRAIN_OCR_LLM_CORRECT=true

# ── LLM 推理参数 ─────────────────────────────────────
DOCBRAIN_LLM_TEMPERATURE=0.2
DOCBRAIN_LLM_NUM_CTX=8192
